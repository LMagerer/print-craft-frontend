            "default": 0,
            "title": "X Mm",
            "type": "number"
          },
          "y_mm": {
            "default": 0,
            "title": "Y Mm",
            "type": "number"
          },
          "width_mm": {
            "default": 10,
            "exclusiveMinimum": 0,
            "title": "Width Mm",
            "type": "number"
